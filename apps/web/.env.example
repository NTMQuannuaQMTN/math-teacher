# Copy to apps/web/.env.local for `npm run dev` (Next.js). For the Workers build (vinext), put API_ORIGIN and
# API_GATEWAY_SECRET in apps/web/.dev.vars locally and use `wrangler secret put` in production.

# Python API origin (server-side only; never exposed to the browser).
API_ORIGIN=http://127.0.0.1:8000
# Must equal GATEWAY_SECRET in services/api/.env when that is set.
API_GATEWAY_SECRET=
# Development only: lets /admin/usage work locally. Never set in production (Cloudflare Access is used).
ADMIN_DEV_TOKEN=dev-admin-token-change-me
# Public Turnstile site key (build-time). Empty = no challenge (development).
# Cloudflare test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
