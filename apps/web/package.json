{
  "name": "math-tutor-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript ../../services/api/openapi.json -o lib/api-types.ts",
    "test:e2e": "playwright test",
