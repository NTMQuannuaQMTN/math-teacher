# Base URL of the Worker API. Not a secret (it ships in the app bundle).
# If unset in development, the app uses the Metro host's IP on port 8787, which works
# for simulators and for phones on the same Wi-Fi as your computer.
EXPO_PUBLIC_API_URL=

# Optional: longer client timeouts when the API runs local models (OCR_PROVIDER/SOLVER_PROVIDER=local).
# EXPO_PUBLIC_OCR_TIMEOUT_MS=600000
# EXPO_PUBLIC_SOLVE_TIMEOUT_MS=1800000
