{
  "expo": {
    "name": "Trợ lý Toán học",
    "slug": "math-teacher",
    "scheme": "mathteacher",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathteacher.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần dùng máy ảnh để chụp đề bài toán bạn muốn giải.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cho phép bạn chọn ảnh đề bài toán từ thư viện ảnh."
      }
    },
    "android": {
      "package": "com.mathteacher.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần dùng máy ảnh để chụp đề bài toán bạn muốn giải.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cho phép bạn chọn ảnh đề bài toán từ thư viện ảnh.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
