# Copy to services/api/.env for local development. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mathtutor:mathtutor@127.0.0.1:54329/mathtutor

# SoCLaaS (NUS SoC LLM gateway, OpenAI-compatible). Key from https://soclaas-portal.comp.nus.edu.sg
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
SOCLAAS_TIMEOUT_SECONDS=120
SOCLAAS_MAX_RETRIES=1
MODEL_CATALOG_PATH=config/models.json
# Required only if any catalogue price is in USD.
FX_USD_TO_SGD=
# soclaas (real OCR) | fixture (tests/E2E only; refused in production)
OCR_PROVIDER=soclaas

# Budget (SGD per Asia/Singapore day)
DAILY_BUDGET_SGD=10.00
RESTRICTED_BUDGET_SGD=9.00
WARNING_BUDGET_SGD=7.00
PER_USER_DAILY_BUDGET_SGD=1.50

# Gateway shared secret (must match the web Worker's API_GATEWAY_SECRET). Required in production.
GATEWAY_SECRET=
# Cloudflare Turnstile secret. Empty disables verification (development only).
# Cloudflare test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Cloudflare Access (admin routes). Required in production.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
ADMIN_EMAILS=[]
# Development-only admin token (header X-Admin-Token). Refused in production.
ADMIN_DEV_TOKEN=dev-admin-token-change-me

# Storage: local (development) | s3 (Cloudflare R2 in production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
S3_ENDPOINT_URL=
S3_BUCKET=math-tutor
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

RUN_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
