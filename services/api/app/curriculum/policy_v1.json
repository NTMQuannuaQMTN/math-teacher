        "\\\\cap"
      ]
    },
    {
      "id": "separate_recheck",
      "message_vi": "Không cần bước \"kiểm tra lại\" riêng; trình bày lập luận đúng ngay từ đầu.",
      "patterns": [
        "kiểm tra lại"
      ]
    },
    {
      "id": "guessing",
      "message_vi": "Không dùng \"thử các số nhỏ\" thay cho lập luận.",
      "patterns": [
        "thử các số nhỏ",
        "thử vài giá trị",
        "đoán nghiệm"
      ]
    },
    {
      "id": "gamma_circle",
      "topic": "geometry",
