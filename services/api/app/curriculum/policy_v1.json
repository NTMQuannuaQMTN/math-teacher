  "style": [
    {
      "id": "self_talk",
      "message_vi": "Lời giải có câu tự nói, tự sửa sai hoặc bỏ dở (\"Chờ đã\", \"Đó là sai lầm\", \"Hãy tính lại\", \"cách nhanh hơn là\"). Chỉ trình bày lập luận cuối cùng, đúng ngay từ đầu; bỏ các bước bị bỏ dở, bị tính lại hoặc bị sửa.",
      "patterns": [
        "chờ đã",
        "\\bwait\\b",
        "\\bhmm\\b",
        "\\boops\\b",
        "thử lại",
        "\\bà không\\b",
        "nhầm",
        "sai lầm",
        "(tính|làm|sửa|giải) lại",
        "xin lỗi",
        "suy luận nhanh",
        "cách nhanh hơn",
        "(bước|lập luận|phần|kết quả|cách) (ở )?trên (là )?(sai|chưa đúng)"
      ]
    },
    {
      "id": "english_text",
      "message_vi": "Lời giải có câu tiếng Anh.",
      "patterns": [
        "\\b(therefore|thus|hence|we have|let us|so that|note that)\\b"
      ]
    },
    {
      "id": "set_intersection_geometry",
      "topic": "geometry",
      "message_vi": "Không dùng kí hiệu giao tập hợp; viết \"Gọi P là giao điểm của …\".",
