{
  "name": "math-teacher-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply math_teacher_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply math_teacher_db --remote",
    "smoke": "node scripts/smoke.mjs",
    "smoke:solve": "node scripts/smoke-solve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
